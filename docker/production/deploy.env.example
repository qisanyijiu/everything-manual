# Replace image references with immutable IDs/digests from the release manifest.
EM_IMAGE=sha256:REPLACE_WITH_APPLICATION_IMAGE_ID
EM_PROXY_IMAGE=nginx@sha256:REPLACE_WITH_PROXY_IMAGE_DIGEST
EM_DOCKER_PLATFORM=linux/amd64

# This must match the actual browser origin exactly (including nondefault port).
EM_PUBLIC_ORIGIN=https://REPLACE_WITH_ACTUAL_HOST:8443
# Loopback is the safe default. Set 0.0.0.0 and port 443 only for intended exposure.
EM_HTTPS_BIND=127.0.0.1
EM_HTTPS_PORT=8443

# Paths only: never put password, master key, API key or TLS key contents here.
EM_ADMIN_PASSWORD_FILE=/srv/everything-manual/private/admin-password.txt
EM_MASTER_KEY_FILE=/srv/everything-manual/private/master.key
EM_TLS_CERT_FILE=/srv/everything-manual/private/fullchain.pem
EM_TLS_KEY_FILE=/srv/everything-manual/private/privkey.pem

# Optional absolute bind paths. Otherwise project-scoped named volumes are used.
# EM_DATA_PATH=/srv/everything-manual/data
# EM_RUNTIME_CONFIG_PATH=/srv/everything-manual/private/provider-config
