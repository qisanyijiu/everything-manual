# Start from a source-only allowlist. Local previews, keys and test evidence never
# enter the build context, including in intermediate image layers.
**
!Dockerfile
!.dockerignore
!Cargo.toml
!Cargo.lock
!rust-toolchain.toml
!config.example.toml
!price-catalog.example.toml
!.cargo/
!.cargo/config.toml
!crates/
!crates/**
!xtask/
!xtask/**
!migrations/
!migrations/**
!contracts/
!contracts/**
!tests/
!tests/fixtures/
!tests/fixtures/**
!apps/
!apps/web/
!apps/web/**
!docker/
!docker/entrypoint.sh
!docker/config.toml

**/target/
**/node_modules/
**/dist/
**/coverage/
**/playwright-report/
**/test-results/
**/.git/
**/.env
**/.env.*
**/*.local
**/*.pem
**/*.key
**/*.sqlite3*
**/provider-overrides*.json
**/*.api-key.enc
**/*.api-key.*.tmp
**/*.log
**/var/
**/artifacts/
